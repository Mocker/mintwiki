{
  // MintWiki Cloudflare runtime. Deploy with: npx wrangler deploy
  // Ryan steps at deploy time (M3.5): set the two secrets and attach the
  // mintwiki.gup.io custom domain (dashboard — the API token Muse holds
  // has no DNS scope).
  //   npx wrangler secret put SIGNING_SECRET
  //   npx wrangler secret put OWNER_ADMIN_TOKEN
  "name": "mintwiki",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [{ "name": "WIKI", "class_name": "WikiDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WikiDO"] }],
  "r2_buckets": [{ "binding": "BLOB", "bucket_name": "mintwiki-blobs" }]
  // No vars: owner operations are the /v1/admin/* surface (M3.4),
  // gated by the OWNER_ADMIN_TOKEN secret. The old ALLOW_SEED switch
  // and its bootstrap routes are retired.
}
